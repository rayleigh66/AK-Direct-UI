# Copy this file to .env for local deployment. Never commit .env.
# Use a strong password and URL-encode it inside DATABASE_URL if it contains
# characters such as @, :, /, ? or #.
POSTGRES_DB=aoking_direct
POSTGRES_USER=aoking
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://aoking:change-me-local-only@db:5432/aoking_direct

# Web is published only on the loopback interface by default.
WEB_PORT=8080

# Automated PostgreSQL backup retention. Offsite copy is not configured yet.
BACKUP_RETENTION_DAYS=30

# Leave empty for local/loopback validation. Production requires Owner-
# confirmed DNS and a domain; see docs/PHASE_4B01_DEPLOYMENT.md.
DOMAIN=

# Development/test seeding is opt-in and refuses production.
SEED_DEV_DATA=no

# Independent local test database. Never point this at production.
TEST_DATABASE_URL=postgres://aoking_test:aoking_test_password@127.0.0.1:55433/aoking_direct_test
