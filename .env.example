# Copy this file to .env for local deployment. Never commit .env.
# Use strong passwords and URL-encode them inside the URLs if they contain
# characters such as @, :, /, ? or #.
POSTGRES_DB=aoking_direct
POSTGRES_USER=aoking
POSTGRES_PASSWORD=change-me-owner-password

# Migration/owner connection. Only the one-shot migrate service uses this.
MIGRATION_DATABASE_URL=postgres://aoking:change-me-owner-password@db:5432/aoking_direct

# Least-privilege runtime role used by the API. The migrate service creates it.
RUNTIME_DB_USER=aoking_runtime
RUNTIME_DB_PASSWORD=change-me-runtime-password
DATABASE_URL=postgres://aoking_runtime:change-me-runtime-password@db:5432/aoking_direct

# Web is published only on the loopback interface by default.
WEB_PORT=8080

# Automated PostgreSQL backup retention. Offsite copy is not configured yet.
# The backup service also writes a separate *_media_*.tar.gz archive for the
# product-image volume; database dumps do not contain image files.
BACKUP_RETENTION_DAYS=30
BACKUP_HOST_DIR=./backups

# Leave empty for local/loopback validation. Production requires Owner-
# confirmed DNS and a domain; see docs/PHASE_4B01_DEPLOYMENT.md.
DOMAIN=

# Cookie security: false for local HTTP; true behind production HTTPS.
COOKIE_SECURE=false
CUSTOMER_SESSION_IDLE_HOURS=24
CUSTOMER_SESSION_ABSOLUTE_DAYS=30
INTERNAL_SESSION_IDLE_HOURS=2
INTERNAL_SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
TRUST_PROXY=0
# IANA time zone used for the YYMMDD part of daily order numbers.
ORDER_NUMBER_TIME_ZONE=UTC

# React real-auth gate. Keep false for the existing Mock test suite; set true
# for a real login/session build against the API. scripts/real-auth-e2e.sh
# forces this to true for the isolated Phase 4B-05 stack.
VITE_REAL_AUTH=false

# Phase 4B-05 isolation. These are optional; when unset, Compose keeps its
# existing aoking-direct-*:4b04 images/project. For 4B-05 verification export
# all of them (or pass -p) so the shared stack is never rebuilt or migrated:
# COMPOSE_PROJECT_NAME=akd4b05-test
# API_IMAGE=akd4b05-test-api:local
# MIGRATE_IMAGE=akd4b05-test-migrate:local
# WEB_IMAGE=akd4b05-test-web:local
# WEB_PORT=18705

# Development/test seeding is opt-in and refuses production.
SEED_DEV_DATA=no

# Destructive API integration tests are not loaded from this file. Run them
# explicitly with NODE_ENV=test, TEST_DATABASE_DESTRUCTIVE=yes and an exact
# loopback aoking_test/aoking_direct_test URL. See docs/PHASE_4B01_DEPLOYMENT.md.
