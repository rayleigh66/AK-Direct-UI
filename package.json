{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/api/dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "verify:assets": "node scripts/verify-build-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && playwright test --config=playwright.preview.config.ts",
    "api:dev": "tsx apps/api/src/index.ts",
    "api:lint": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.test.json --noEmit",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node apps/api/dist/index.js",
    "api:migrate": "tsx apps/api/src/db/migrate.ts",
    "api:test": "vitest run apps/api/tests/unit",
    "api:test:db": "vitest run --config vitest.integration.config.ts",
    "api:seed:dev": "tsx apps/api/src/db/seed-dev.ts",
    "api:provision:roles": "tsx apps/api/src/db/provision-runtime-role.ts",
    "api:create-admin": "tsx apps/api/src/auth/create-admin.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.14",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
